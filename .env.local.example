# Copy to .env.local and fill in.

# HubSpot Private App token (Bearer). Needs read scopes for:
#   crm.objects.contacts.read, crm.objects.companies.read,
#   and engagement (calls/emails) read + associations.read
HUBSPOT_PAT=pat-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional — enables no-redeploy refresh via Vercel Blob.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Supabase (call-scoring project) — auth + call-quality reads
# URL + anon key are safe to expose (client auth); service role key is SERVER-ONLY.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI (hot-account agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Slack Incoming Webhooks for Slack Reports — server-only, NEVER prefix with NEXT_PUBLIC_.
# An admin creates a Slack destination in /slack-reports that references the env var NAME below
# (e.g. "SLACK_VAIBHAV_WEBHOOK") — the webhook URL itself is never stored in the database, never
# returned by an API response, and never logged. Add one var per destination channel.
SLACK_VAIBHAV_WEBHOOK=
SLACK_RAJVEER_WEBHOOK=

# GitHub Actions dispatch (fine-grained PAT, actions:write) — powers the delta-sync heartbeat's
# self-redispatch, the admin add-user owner-pull, AND the Slack Reports heartbeat/"Run Now".
# GH_DISPATCH_TOKEN=
# GH_REPO=owner/repo
